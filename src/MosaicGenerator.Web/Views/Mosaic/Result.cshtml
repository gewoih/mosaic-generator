@model ResultViewModel
@{
    ViewData["Title"] = "Макет";
    StoredResult stored = Model.Stored;
    string id = Model.Id;
    CultureInfo ru = CultureInfo.GetCultureInfo("ru-RU");
    var pinned = new HashSet<string>(stored.PinnedArticles, StringComparer.OrdinalIgnoreCase);
    bool reduced = stored.ColorsBeforeReduction > stored.Lines.Count;

    int ladderMin = stored.ColorLadder.Count > 0 ? stored.ColorLadder.Min(r => r.ColorCount) : stored.Lines.Count;
    int ladderMax = stored.ColorLadder.Count > 0 ? stored.ColorLadder.Max(r => r.ColorCount) : stored.Lines.Count;
    // How far down and up the arrows may step at all — inside [ladderMin, ladderMax] the swap is
    // instant, outside it the page asks for a full regeneration at that number.
    int arrowMin = 2;
    int arrowMax = Math.Max(stored.ChosenColors, Math.Min(stored.ColorCeiling, stored.ColorsBeforeReduction));

    Palette? currentPalette = Model.Parameters.Palettes
        .FirstOrDefault(p => string.Equals(p.Id, stored.PaletteId, StringComparison.OrdinalIgnoreCase));
    string paletteJson = JsonSerializer.Serialize(new
    {
        articles = (currentPalette?.Colors ?? []).Select(color => new
        {
            article = color.Article,
            name = color.Name,
            hex = color.Hex,
            lab = new[] { color.Lab.L, color.Lab.A, color.Lab.B },
        }),
    });

    string ladderJson = JsonSerializer.Serialize(new
    {
        chosen = stored.ChosenColors,
        auto = stored.AutoColors,
        ceiling = stored.ColorCeiling,
        before = stored.ColorsBeforeReduction,
        total = stored.TotalModules,
        bakedMin = ladderMin,
        bakedMax = ladderMax,
        arrowMin,
        arrowMax,
        rungs = stored.ColorLadder.ToDictionary(
            r => r.ColorCount.ToString(CultureInfo.InvariantCulture),
            r => new
            {
                reassigned = r.ModulesReassigned,
                area = r.TotalGrossAreaM2,
                mass = r.TotalMassKg,
                cost = r.TotalCost,
                lines = r.Lines.Select(l => new
                {
                    code = l.Code,
                    hold = l.Article,
                    name = l.Name,
                    hex = l.Hex,
                    count = l.ModuleCount,
                    area = l.GrossAreaM2,
                    mass = l.MassKg,
                    cost = l.Cost,
                }),
            }),
    });
}

<div class="workbench">
    <form class="rail" id="regenerate" asp-action="Regenerate" method="post"
          enctype="multipart/form-data" data-layout-form>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="errors"></div>
        <input type="hidden" name="SourceId" value="@stored.SourceId" />
        <input type="hidden" name="ForceColors" value="0" data-force-colors />

        <details class="crop-fold">
            <summary>Кадр</summary>
            <div class="crop-fold__body">
                @await Html.PartialAsync("_Cropper", Model.Parameters)
            </div>
        </details>

        <hr />

        @await Html.PartialAsync("_Controls", Model.Parameters)

        <button class="button button--block" type="submit">Пересобрать макет</button>
    </form>

    <div class="stage">
        <div class="summary-line">
            <b>@((stored.PanelWidthMm / 10).ToString("0.#", ru)) × @((stored.PanelHeightMm / 10).ToString("0.#", ru)) см</b>
            <span>·</span>
            <b>@stored.Columns × @stored.Rows</b> = @stored.TotalModules.ToString("N0", ru) модулей
            <span>·</span>
            откус @stored.ModuleSizeMm.ToString("0.#", ru) / шов @stored.GroutWidthMm.ToString("0.#", ru) мм
            <span>·</span>
            <span data-color-count>@stored.Lines.Count</span> цв.
        </div>

        @if (stored.StoppedAtPinnedColors)
        {
            <p class="callout">Закреплённых артикулов больше лимита цветов — лимит уступил закреплению.</p>
        }
        @if (reduced)
        {
            double share = (double)stored.ModulesReassigned / stored.TotalModules * 100;
            string picked = stored.ChosenColors == stored.AutoColors
                ? $"взял {stored.ChosenColors} цветов из {stored.ColorCeiling}"
                : $"задано вручную {stored.ChosenColors} цветов (авто предлагал {stored.AutoColors} из {stored.ColorCeiling})";
            <p class="callout" data-reduction-note>
                @picked: свёрнуто @(stored.ColorsBeforeReduction - stored.Lines.Count) оттенков,
                переназначено <span data-reassigned>@stored.ModulesReassigned.ToString("N0", ru)</span> из
                @stored.TotalModules.ToString("N0", ru) модулей
                (<span data-reassigned-share>@share.ToString("0.#", ru)</span> %).
            </p>
        }

        <div class="tabs" data-tabs>
            <div class="tabs__list" role="tablist" aria-label="Выходные листы">
                <button type="button" class="tabs__tab" role="tab" data-tab="cartoon" aria-selected="true">Картон</button>
                <button type="button" class="tabs__tab" role="tab" data-tab="legend" aria-selected="false">Легенда</button>
                <button type="button" class="tabs__tab" role="tab" data-tab="scheme" aria-selected="false">Схема</button>
            </div>

            <div class="tabpanel" role="tabpanel" data-panel="cartoon">
                <div class="color-step" data-color-step
                     data-cartoon-url="@Url.Action("Cartoon", new { id })"
                     data-download-url="@Url.Action("Cartoon", new { id, download = true })"
                     data-pdf-url="@Url.Action("CartoonPdf", new { id })">
                    <button type="button" class="button button--small" data-step="-1" aria-label="Меньше цветов">◄</button>
                    <span class="color-step__label" data-step-label>@stored.ChosenColors цв.</span>
                    <button type="button" class="button button--small" data-step="1" aria-label="Больше цветов">►</button>
                    <span class="color-step__hint" data-step-hint></span>
                </div>
                <img src="@Url.Action("Cartoon", new { id })" alt="Картон под набор" data-cartoon-img />
                <div class="tabpanel__bar">
                    <span class="dims">@stored.CartoonWidthPx × @stored.CartoonHeightPx px · @stored.CartoonDpi.ToString("0", ru) dpi</span>
                    <a class="button button--small" href="@Url.Action("Cartoon", new { id, download = true })" data-cartoon-download>Скачать PNG</a>
                    <a class="button button--small" href="@Url.Action("CartoonPdf", new { id })" data-cartoon-pdf>Печать A4 (PDF)</a>
                </div>
            </div>

            <div class="tabpanel" role="tabpanel" data-panel="legend" hidden>
                <img src="@Url.Action("Legend", new { id })" alt="Легенда: плашки, коды, число кусков" />
                <div class="tabpanel__bar">
                    <span class="dims">плашка · номер · артикул · число кусков</span>
                    <a class="button button--small" data-download="legend"
                       href="@Url.Action("Legend", new { id, download = true })">Скачать PNG</a>
                </div>
                <p class="tabpanel__note">Печатать отдельным листом, чтобы не отнимать место у поля мозаики.</p>
            </div>

            <div class="tabpanel" role="tabpanel" data-panel="scheme" hidden>
                <img src="@Url.Action("Scheme", new { id })" alt="Схема для разбора раскладки" />
                <div class="tabpanel__bar">
                    <span class="dims">@stored.SchemeWidthPx × @stored.SchemeHeightPx px · @stored.SchemeDpi.ToString("0", ru) dpi</span>
                    <a class="button button--small" data-download="scheme"
                       href="@Url.Action("Scheme", new { id, download = true })">Скачать PNG</a>
                </div>
                <p class="tabpanel__note">Пронумерованная раскладка — для разбора алгоритма, не для набора.</p>
            </div>
        </div>
    </div>
</div>

<section class="consumption" data-recolor="@(Model.CanRecolor ? "on" : "off")"
         data-cartoon-url="@Url.Action("Cartoon", new { id })"
         data-scheme-url="@Url.Action("Scheme", new { id })"
         data-legend-url="@Url.Action("Legend", new { id })"
         data-consumption-url="@Url.Action("Consumption", new { id })"
         data-cartoon-pdf-url="@Url.Action("CartoonPdf", new { id })"
         data-scheme-pdf-url="@Url.Action("SchemePdf", new { id })">
    <div class="consumption__head">
        <h2>Расход материала</h2>
        @if (Model.CanRecolor)
        {
            <button type="button" class="button button--small" data-recolor-reset hidden>Сбросить замены</button>
        }
    </div>
    @if (Model.CanRecolor)
    {
        <p class="consumption__hint">Клик по артикулу — заменить его на другой цвет прямо на картоне.</p>
    }
    else
    {
        <p class="consumption__hint">Замена цвета на готовом картоне доступна после пересборки макета.</p>
    }
    <div class="table-scroll">
        <table>
            <thead>
            <tr>
                <th>Код</th>
                <th title="Не сворачивать этот артикул">Держать</th>
                <th>Артикул</th>
                <th>Название</th>
                <th class="numeric">Модулей</th>
                <th class="numeric">Площадь с запасом, м²</th>
                <th class="numeric">Масса, кг</th>
                <th class="numeric">Стоимость, ₽</th>
            </tr>
            </thead>
            <tbody data-consumption-body>
            @foreach (StoredMaterialLine line in stored.Lines)
            {
                <tr data-article="@line.Article">
                    <td class="code">@line.Code</td>
                    <td class="hold">
                        <input type="checkbox" form="regenerate" name="PinnedArticles" value="@line.Article"
                               checked="@pinned.Contains(line.Article)"
                               aria-label="Не сворачивать @line.Article" />
                    </td>
                    <td class="mono">
                        @if (Model.CanRecolor)
                        {
                            <button type="button" class="swap-open" data-swap-open>@line.Article</button>
                        }
                        else
                        {
                            @line.Article
                        }
                    </td>
                    <td>
                        <span class="dot" style="background:@line.Hex"></span>
                        <span data-line-name>@line.Name</span>
                    </td>
                    <td class="numeric">@line.ModuleCount.ToString("N0", ru)</td>
                    <td class="numeric">@line.GrossAreaM2.ToString("N3", ru)</td>
                    <td class="numeric">@line.MassKg.ToString("N2", ru)</td>
                    <td class="numeric">@line.Cost.ToString("N0", ru)</td>
                </tr>
            }
            </tbody>
            <tfoot>
            <tr>
                <td colspan="4">Итого</td>
                <td class="numeric">@stored.TotalModules.ToString("N0", ru)</td>
                <td class="numeric" data-total-area>@stored.TotalGrossAreaM2.ToString("N3", ru)</td>
                <td class="numeric" data-total-mass>@stored.TotalMassKg.ToString("N2", ru)</td>
                <td class="numeric" data-total-cost>@stored.TotalCost.ToString("N0", ru)</td>
            </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
    <script type="application/json" data-layout-data>@Html.Raw(Model.Parameters.LayoutDataJson)</script>
    <script type="application/json" data-color-ladder>@Html.Raw(ladderJson)</script>
    <script type="application/json" data-palette>@Html.Raw(paletteJson)</script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/crop.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/recolor.js" asp-append-version="true"></script>
}
