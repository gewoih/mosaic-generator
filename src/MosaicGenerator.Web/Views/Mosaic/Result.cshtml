@model ResultViewModel
@{
    ViewData["Title"] = "Макет";
    StoredResult stored = Model.Stored;
    string id = Model.Id;
    CultureInfo ru = CultureInfo.GetCultureInfo("ru-RU");
    var pinned = new HashSet<string>(stored.PinnedArticles, StringComparer.OrdinalIgnoreCase);
    bool reduced = stored.ColorsBeforeReduction > stored.Lines.Count;
}

<div class="workbench">
    <form class="rail" id="regenerate" asp-action="Regenerate" method="post"
          enctype="multipart/form-data" data-layout-form>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="errors"></div>
        <input type="hidden" name="SourceId" value="@stored.SourceId" />

        <details class="crop-fold">
            <summary>Кадр</summary>
            <div class="crop-fold__body">
                @await Html.PartialAsync("_Cropper", Model.Parameters)
            </div>
        </details>

        <hr />

        @await Html.PartialAsync("_Controls", Model.Parameters)

        <button class="button button--block" type="submit">Пересобрать макет</button>
    </form>

    <div class="stage">
        <div class="summary-line">
            <b>@((stored.PanelWidthMm / 10).ToString("0.#", ru)) × @((stored.PanelHeightMm / 10).ToString("0.#", ru)) см</b>
            <span>·</span>
            <b>@stored.Columns × @stored.Rows</b> = @stored.TotalModules.ToString("N0", ru) модулей
            <span>·</span>
            откус @stored.ModuleSizeMm.ToString("0.#", ru) / шов @stored.GroutWidthMm.ToString("0.#", ru) мм
            <span>·</span>
            @stored.Lines.Count цв.
        </div>

        @if (stored.StoppedAtPinnedColors)
        {
            <p class="callout">Закреплённых артикулов больше лимита цветов — лимит уступил закреплению.</p>
        }
        @if (reduced)
        {
            double share = (double)stored.ModulesReassigned / stored.TotalModules * 100;
            <p class="callout">
                Свёрнуто @(stored.ColorsBeforeReduction - stored.Lines.Count) оттенков при лимите
                @stored.MaxColors: переназначено @stored.ModulesReassigned из
                @stored.TotalModules.ToString("N0", ru) модулей (@share.ToString("0.#", ru) %).
            </p>
        }

        <div class="tabs" data-tabs>
            <div class="tabs__list" role="tablist" aria-label="Выходные листы">
                <button type="button" class="tabs__tab" role="tab" data-tab="cartoon" aria-selected="true">Картон</button>
                <button type="button" class="tabs__tab" role="tab" data-tab="legend" aria-selected="false">Легенда</button>
                <button type="button" class="tabs__tab" role="tab" data-tab="scheme" aria-selected="false">Схема</button>
            </div>

            <div class="tabpanel" role="tabpanel" data-panel="cartoon">
                <img src="@Url.Action("Cartoon", new { id })" alt="Картон под набор" />
                <div class="tabpanel__bar">
                    <span class="dims">@stored.CartoonWidthPx × @stored.CartoonHeightPx px · @stored.CartoonDpi.ToString("0", ru) dpi</span>
                    <a class="button button--small" href="@Url.Action("Cartoon", new { id, download = true })">Скачать PNG</a>
                </div>
            </div>

            <div class="tabpanel" role="tabpanel" data-panel="legend" hidden>
                <img src="@Url.Action("Legend", new { id })" alt="Легенда: плашки, коды, число кусков" />
                <div class="tabpanel__bar">
                    <span class="dims">плашка · номер · артикул · число кусков</span>
                    <a class="button button--small" href="@Url.Action("Legend", new { id, download = true })">Скачать PNG</a>
                </div>
                <p class="tabpanel__note">Печатать отдельным листом, чтобы не отнимать место у поля мозаики.</p>
            </div>

            <div class="tabpanel" role="tabpanel" data-panel="scheme" hidden>
                <img src="@Url.Action("Scheme", new { id })" alt="Схема для разбора раскладки" />
                <div class="tabpanel__bar">
                    <span class="dims">@stored.SchemeWidthPx × @stored.SchemeHeightPx px · @stored.SchemeDpi.ToString("0", ru) dpi</span>
                    <a class="button button--small" href="@Url.Action("Scheme", new { id, download = true })">Скачать PNG</a>
                </div>
                <p class="tabpanel__note">Пронумерованная раскладка — для разбора алгоритма, не для набора.</p>
            </div>
        </div>
    </div>
</div>

<section class="consumption">
    <h2>Расход материала</h2>
    <div class="table-scroll">
        <table>
            <thead>
            <tr>
                <th>Код</th>
                <th title="Не сворачивать этот артикул">Держать</th>
                <th>Артикул</th>
                <th>Название</th>
                <th class="numeric">Модулей</th>
                <th class="numeric">Площадь с запасом, м²</th>
                <th class="numeric">Масса, кг</th>
                <th class="numeric">Стоимость, ₽</th>
            </tr>
            </thead>
            <tbody>
            @foreach (StoredMaterialLine line in stored.Lines)
            {
                <tr>
                    <td class="code">@line.Code</td>
                    <td class="hold">
                        <input type="checkbox" form="regenerate" name="PinnedArticles" value="@line.Article"
                               checked="@pinned.Contains(line.Article)"
                               aria-label="Не сворачивать @line.Article" />
                    </td>
                    <td class="mono">@line.Article</td>
                    <td>
                        <span class="dot" style="background:@line.Hex"></span>
                        @line.Name
                    </td>
                    <td class="numeric">@line.ModuleCount.ToString("N0", ru)</td>
                    <td class="numeric">@line.GrossAreaM2.ToString("N3", ru)</td>
                    <td class="numeric">@line.MassKg.ToString("N2", ru)</td>
                    <td class="numeric">@line.Cost.ToString("N0", ru)</td>
                </tr>
            }
            </tbody>
            <tfoot>
            <tr>
                <td colspan="4">Итого</td>
                <td class="numeric">@stored.TotalModules.ToString("N0", ru)</td>
                <td class="numeric">@stored.TotalGrossAreaM2.ToString("N3", ru)</td>
                <td class="numeric">@stored.TotalMassKg.ToString("N2", ru)</td>
                <td class="numeric">@stored.TotalCost.ToString("N0", ru)</td>
            </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
    <script type="application/json" data-layout-data>@Html.Raw(Model.Parameters.LayoutDataJson)</script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/crop.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
}
