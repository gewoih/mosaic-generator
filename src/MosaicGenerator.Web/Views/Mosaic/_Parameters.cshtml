@model ParametersViewModel

<fieldset class="field-group">
    <legend>Панно</legend>
    <label class="field">
        <span class="field__label">Ширина, см</span>
        <input name="PanelWidthCm" type="number" step="1" min="10" max="300"
               value="@Model.Form.PanelWidthCm.ToString(CultureInfo.InvariantCulture)" data-panel="width" />
    </label>
    <label class="field">
        <span class="field__label">Высота, см</span>
        <input name="PanelHeightCm" type="number" step="1" min="10" max="300"
               value="@Model.Form.PanelHeightCm.ToString(CultureInfo.InvariantCulture)" data-panel="height" />
    </label>
    <output class="readout field--wide" data-readout hidden></output>
</fieldset>

<fieldset class="field-group">
    <legend>Укладка</legend>
    <div class="field field--wide">
        <span class="field__label">Детализация</span>
        <div class="levels">
            @foreach (DetailLevel level in Enum.GetValues<DetailLevel>())
            {
                <label class="level">
                    <input type="radio" name="Detail" value="@level" data-detail
                           checked="@(Model.Form.Detail == level)" />
                    <span class="level__body">
                        <strong>@DetailLevelPresentation.Label(level)</strong>
                        <span>@level.TargetAcross() модулей по короткой стороне</span>
                        <span class="level__hint">@DetailLevelPresentation.Hint(level)</span>
                    </span>
                </label>
            }
        </div>
        <span class="field__hint">
            Размер модуля и шва подбираются под панно автоматически из ряда 5…20 мм.
        </span>
    </div>
</fieldset>

<fieldset class="field-group">
    <legend>Материал</legend>
    <label class="field">
        <span class="field__label">Палитра</span>
        <select name="PaletteId">
            @foreach (Palette palette in Model.Palettes)
            {
                <option value="@palette.Id" selected="@(Model.Form.PaletteId == palette.Id)">
                    @palette.Name (@palette.Colors.Count цв.)
                </option>
            }
        </select>
    </label>
    <label class="field">
        <span class="field__label">Цена материала, ₽/кг</span>
        <input name="PricePerKgRub" type="number" step="10" min="0" max="1000000"
               value="@Model.Form.PricePerKgRub.ToString(CultureInfo.InvariantCulture)" />
        <span class="field__hint">Средняя ставка поставщика по всей линейке. Смета оценочная.</span>
    </label>
    <label class="field">
        <span class="field__label">Максимум цветов</span>
        <input name="MaxColors" type="number" step="1" min="2" max="100"
               value="@Model.Form.MaxColors.ToString(CultureInfo.InvariantCulture)" />
        <span class="field__hint">
            Оттенки сворачиваются по цене ошибки: первым уходит тот, чьи модули найдут
            ближайшую замену, а не тот, что просто редок.
        </span>
    </label>
    <label class="field">
        <span class="field__label">Запас на отходы, %</span>
        <input name="WastePercent" type="number" step="1" min="0" max="100"
               value="@Model.Form.WastePercent.ToString(CultureInfo.InvariantCulture)" />
        <span class="field__hint">Покрывает рез, бой и брак при наборе.</span>
    </label>
    <label class="field field--wide check">
        <input type="checkbox" name="CompensateJoint" value="true" checked="@Model.Form.CompensateJoint" />
        <span>
            <span class="field__label">Учитывать шов при подборе цвета</span>
            <span class="field__hint">
                Клей белый, затирки нет: в глубине шва он затенён и имеет собственную светлоту,
                к которой тянет каждую тессеру. Без поправки панно выходит площе макета.
            </span>
        </span>
    </label>
    <input type="hidden" name="CompensateJoint" value="false" />
</fieldset>
